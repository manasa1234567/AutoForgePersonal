# Microsoft Foundry code-first Agent Framework provider
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_SPEC_MODEL=
# Optional shared model deployment for initial testing; agent-specific names override it.
FOUNDRY_MODEL=
FOUNDRY_ARCHITECTURE_MODEL=
FOUNDRY_CODER_MODEL=
FOUNDRY_CRITIC_MODEL=

# Local: default_azure_credential (for example, after `az login`)
# Azure Container Apps: managed_identity
AUTOFORGE_IDENTITY_MODE=default_azure_credential
AZURE_CLIENT_ID=
AZURE_CONTENT_SAFETY_ENDPOINT=
AZURE_PROMPT_SHIELDS_API_VERSION=2024-09-01

# Optional durable Azure persistence. `local` keeps the in-memory demo adapters.
AUTOFORGE_PERSISTENCE=local
AUTOFORGE_COSMOS_ENDPOINT=
AUTOFORGE_COSMOS_DATABASE=autoforge
AUTOFORGE_COSMOS_JOBS_CONTAINER=jobs
AUTOFORGE_COSMOS_SKILLS_CONTAINER=skills
AUTOFORGE_BLOB_ACCOUNT_URL=
AUTOFORGE_BLOB_SPECS_CONTAINER=specs
AUTOFORGE_BLOB_WORKSPACES_CONTAINER=workspaces

# Optional local compatibility path. Prefer Foundry settings above.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# Optional Jira Cloud read-only issue lookup (keep the API token server-side).
# Store the production token in Key Vault and inject it into the backend runtime.
JIRA_BASE_URL=https://your-company.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
# Optional project-specific acceptance criteria field, e.g. customfield_10042
JIRA_ACCEPTANCE_CRITERIA_FIELD=

# Agent 4 isolated runtime validation (requires a compatible custom ACA session-pool runner).
AUTOFORGE_SANDBOX_ENABLED=false
AUTOFORGE_SANDBOX_ENDPOINT=
AUTOFORGE_SANDBOX_ROUTE=/autoforge/validate
AUTOFORGE_SANDBOX_TIMEOUT_SECONDS=120

# Agent 6 release setup. Publishing only runs after the human release approval.
AUTOFORGE_DEPLOYMENT_ENABLED=false
AUTOFORGE_GITHUB_PUBLISH_ENABLED=false
AUTOFORGE_GITHUB_OWNER=
AUTOFORGE_GITHUB_REPOSITORY=
AUTOFORGE_GITHUB_BASE_BRANCH=
AUTOFORGE_GITHUB_APP_ID=
AUTOFORGE_GITHUB_INSTALLATION_ID=
# Store the base64-encoded GitHub App PEM private key as a backend/Key Vault secret.
AUTOFORGE_GITHUB_APP_PRIVATE_KEY_BASE64=
AZURE_SUBSCRIPTION_ID=
AZURE_RESOURCE_GROUP=aegis-rg
ACR_LOGIN_SERVER=
ACA_ENVIRONMENT_NAME=aegis-env
ACA_RESOURCE_GROUP=aegis-rg
